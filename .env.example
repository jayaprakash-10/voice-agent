# Phone provider that carries the calls: plivo or twilio
TELEPHONY_PROVIDER=plivo

# Twilio (phone line)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Plivo (phone line)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=

# Groq (LLM)
GROQ_API_KEY=

# Cartesia (text-to-speech)
CARTESIA_API_KEY=

# Public HTTPS URL the phone provider can reach (your ngrok URL in development)
PUBLIC_URL=

# Reject webhook requests not signed by the phone provider
VALIDATE_WEBHOOK_SIGNATURE=true

# Mock clinic. Set to "slow" or "error" to demo how the agent handles a broken booking system.
CLINIC_SIMULATE=off
CLINIC_SEED_BOOKINGS=true
